@using bento_order.Services
@inherits LayoutComponentBase

@inject GlobalState GlobalState
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject BentoDbService BentoDbService

@implements IDisposable
@inject IDialogService DialogService

<MudThemeProvider @ref="_themeProvider"
    @bind-IsDarkMode="@GlobalState.IsDarkMode" Theme="@CustomTheme"/>
<MudPopoverProvider />
<MudSnackbarProvider />
<MudDialogProvider />

<MudLayout>
    @if (!GlobalState.IsInitialized)
    {
        <MudContainer MaxWidth="MaxWidth.Medium" Class="mt-16 text-center">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            <MudText Typo="Typo.body1" Class="mt-4">
                正在載入頁面...
            </MudText>
        </MudContainer>
    }
    else
    {
        @if (GlobalState.CurrentUser != null)
        {
            <MudAppBar Elevation="0" Color="Color.Inherit"
                Class="main-appbar px-2">

                @if (GlobalState.IsAdmin)
                {
                    @* 電腦版：切換左側選單 *@
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                            Color="Color.Inherit" Edge="Edge.Start"
                            OnClick="@((e) => DrawerToggle())" />
                    </MudHidden>

                    @* 手機版：從上方懸浮的下拉選單 *@
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudMenu Icon="@Icons.Material.Filled.Menu"
                            Color="Color.Inherit" AriaLabel="管理選單"
                            AnchorOrigin="Origin.BottomLeft"
                            TransformOrigin="Origin.TopLeft"
                            ListClass="mobile-nav-menu">
                            @foreach (var item in AdminNavItems.All)
                            {
                                <MudMenuItem Href="@item.Href"
                                    Icon="@item.Icon" IconColor="Color.Primary"
                                    Label="@item.Title" />
                            }
                        </MudMenu>
                    </MudHidden>
                }

                @* 標題只在電腦版顯示，手機版空間留給按鈕 *@
                <MudText Typo="Typo.h6" Class="ml-3 appbar-text d-none d-md-flex">
                    bento order
                </MudText>

                <MudSpacer />

                @* 電腦版：主題、菜單為圖示（滑過顯示說明）；改密碼、登出收在姓名下拉選單 *@
                <div class="d-none d-md-flex align-center">
                    <MudTooltip Text="@ThemeToggleText">
                        <MudIconButton Icon="@ThemeToggleIcon"
                            Color="Color.Inherit" Class="mr-2 appbar-text"
                            OnClick="ToggleThemeAsync" />
                    </MudTooltip>

                    <MudTooltip Text="菜單">
                        <MudIconButton
                            Icon="@Icons.Material.Filled.RestaurantMenu"
                            Color="Color.Inherit" Class="mr-2 appbar-text"
                            OnClick="ShowMenu" />
                    </MudTooltip>

                    <MudMenu Label="@DisplayName" Variant="Variant.Text"
                        Color="Color.Inherit" Class="appbar-text"
                        StartIcon="@Icons.Material.Filled.AccountCircle"
                        EndIcon="@Icons.Material.Filled.ArrowDropDown"
                        AnchorOrigin="Origin.BottomRight"
                        TransformOrigin="Origin.TopRight"
                        AriaLabel="帳號選單">
                        <MudMenuItem Icon="@Icons.Material.Filled.Key"
                            Label="改密碼" OnClick="ShowChangePassword" />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                            Label="登出" OnClick="HandleLogout" />
                    </MudMenu>
                </div>

                @* 手機版：只有圖示，加上 tooltip 說明（長按或滑過顯示） *@
                <div class="d-flex d-md-none align-center">
                    <MudTooltip Text="@ThemeToggleText">
                        <MudIconButton Icon="@ThemeToggleIcon"
                            Color="Color.Inherit" OnClick="ToggleThemeAsync" />
                    </MudTooltip>

                    <MudTooltip Text="菜單">
                        <MudIconButton
                            Icon="@Icons.Material.Filled.RestaurantMenu"
                            Color="Color.Inherit" OnClick="ShowMenu" />
                    </MudTooltip>

                    <MudTooltip Text="改密碼">
                        <MudIconButton Icon="@Icons.Material.Filled.Key"
                            Color="Color.Inherit" OnClick="ShowChangePassword" />
                    </MudTooltip>

                    <MudTooltip Text="登出">
                        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                            Color="Color.Inherit" OnClick="HandleLogout" />
                    </MudTooltip>
                </div>
            </MudAppBar>

            @if (GlobalState.IsAdmin)
            {
                @* 左側選單只在電腦版顯示；手機版改用 AppBar 的下拉選單 *@
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudDrawer Variant="DrawerVariant.Persistent"
                        Elevation="0" ClipMode="DrawerClipMode.Always"
                        @bind-Open="_drawerOpen" Width="180px">
                        <NavMenu />
                    </MudDrawer>
                </MudHidden>
            }
        }
        <MudMainContent>
            @if (GlobalState.CurrentUser != null &&
                GlobalState.MustChangePassword)
            {
                @* 使用預設密碼登入：改完密碼前不顯示任何頁面 *@
                <MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="mt-8">
                    <MudPaper Class="pa-6" Elevation="2">
                        <MudText Typo="Typo.h6" Style="font-weight: 800;">
                            請先修改密碼
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-2">
                            您目前使用的是預設密碼，修改後才能繼續使用。
                        </MudText>
                        <ChangePasswordForm />
                    </MudPaper>
                </MudContainer>
            }
            else
            {
                <ErrorBoundary @ref="_errorBoundary">
                    <ChildContent>
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-8">
                            <MudAlert Severity="Severity.Error">
                                發生未預期的錯誤，請重新整理頁面後再試一次。
                            </MudAlert>
                            <MudButton Variant="Variant.Filled"
                                Color="Color.Primary" Class="mt-4"
                                OnClick="ReloadPage">
                                重新整理
                            </MudButton>
                        </MudContainer>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </MudMainContent>
    }
</MudLayout>

@* 連線中斷等無法復原的錯誤時，由 Blazor 顯示（樣式在 MainLayout.razor.css） *@
<div id="blazor-error-ui">
    發生錯誤，畫面已停止回應。
    <a href="" class="reload">重新整理</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _drawerOpen = true;

    void DrawerToggle() => _drawerOpen = !_drawerOpen;

    // 主題顏色配置
    private readonly MudTheme CustomTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            AppbarBackground = "#F7F3EE",
            AppbarText = "#4E342E",
            Background = "#F7F3EE",

            Primary = "#FF9800",
            Secondary = "#8D6E63",

            DrawerBackground = "#FFFEFA",
            DrawerText = "#4E342E",
            DrawerIcon = "#FF9800",

            Surface = "#FFFFFF",
            LinesDefault = "#E0D7C6",
        },
        // 暗色：深咖啡底、橘色重點，與亮色同一套風格
        PaletteDark = new PaletteDark()
        {
            AppbarBackground = "#221E1A",
            AppbarText = "#F3E5D8",
            Background = "#1C1916",
            BackgroundGray = "#26211D",

            Primary = "#FFA726",
            Secondary = "#BCAAA4",

            DrawerBackground = "#221E1A",
            DrawerText = "#E8DCD0",
            DrawerIcon = "#FFA726",

            Surface = "#2A2420",
            TextPrimary = "#EDE3D9",
            TextSecondary = "#B5A79A",
            ActionDefault = "#C8B8AA",
            LinesDefault = "#4A3F37",
            LinesInputs = "#6B5D52",
            Divider = "#4A3F37",
            TableLines = "#4A3F37",
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "12px",
            AppbarHeight = "64px"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] {
                    "Noto Sans TC", "微軟正黑體", "sans-serif"
                }
            }
        }
    };

    // 主題偏好（App.razor 從 cookie 讀出）："dark"、"light"，null = 跟隨系統
    [CascadingParameter(Name = "ThemePreference")]
    private string? ThemePreference { get; set; }

    private MudThemeProvider? _themeProvider;

    private string ThemeToggleIcon => GlobalState.IsDarkMode
        ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode;
    // AppBar 顯示的名稱：姓名，沒有姓名則用帳號
    private string DisplayName =>
        string.IsNullOrWhiteSpace(GlobalState.CurrentUser?.Realname)
            ? GlobalState.CurrentUser?.Username ?? string.Empty
            : GlobalState.CurrentUser.Realname;

    private string ThemeToggleText => GlobalState.IsDarkMode ? "切換為亮色" : "切換為暗色";

    // 初始化
    protected override void OnInitialized()
    {
        base.OnInitialized();

        // 有選過主題時，第一次渲染就用對的配色（不會先閃一下亮色）
        if (ThemePreference != null)
        {
            GlobalState.IsDarkMode = ThemePreference == "dark";
        }

        GlobalState.OnChange += OnGlobalStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // 沒選過主題：跟隨系統設定
        if (firstRender && ThemePreference == null && _themeProvider != null)
        {
            try
            {
                var systemDark = await _themeProvider.GetSystemDarkModeAsync();
                if (systemDark != GlobalState.IsDarkMode)
                {
                    GlobalState.SetDarkMode(systemDark);
                }
            }
            catch (JSException) { }
        }
    }

    // 切換亮色/暗色，並記在 cookie
    private async Task ToggleThemeAsync()
    {
        var isDark = !GlobalState.IsDarkMode;
        GlobalState.SetDarkMode(isDark);
        try
        {
            await JS.InvokeVoidAsync("bentoTheme.set", isDark);
        }
        catch (JSException) { }
    }

    // GlobalState 可能在其他元件的非同步流程中變更，透過 InvokeAsync 回到渲染執行緒
    private void OnGlobalStateChanged() => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        // 先載入是否需改密碼，再設定使用者，避免頁面在檢查前先顯示
        var userId = authState.User.FindFirst(
            System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(userId, out var id))
        {
            var user = await BentoDbService.GetUserAsync(id);
            GlobalState.SetMustChangePassword(
                user?.MustChangePassword ?? false);
        }

        GlobalState.SetCurrentUserFromClaims(authState.User);
    }

    private ErrorBoundary? _errorBoundary;

    // 換頁時清除前一頁的錯誤狀態
    protected override void OnParametersSet()
    {
        _errorBoundary?.Recover();
    }

    private void ReloadPage() =>
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);

    // 修改密碼
    private async Task ShowChangePassword()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.ExtraSmall,
            FullWidth = true
        };

        await DialogService.ShowAsync<ChangePasswordDialog>(
            "修改密碼", options);
    }

    // 離開頁面
    public void Dispose()
    {
        GlobalState.OnChange -= OnGlobalStateChanged;
    }

    // 顯示菜單
    private async Task ShowMenu()
    {
        var options = new DialogOptions {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true,
            NoHeader = true
        };

        var parameters =
            new DialogParameters<MenuDialog>
        {
            // 顯示首頁月曆目前所在月份的菜單
            { x => x.Month, GlobalState.CalendarMonth ?? AppTime.Today }
        };

        await DialogService.ShowAsync<MenuDialog>(
            "本月菜單", parameters, options);
    }

    // 使用者登出
    private async Task HandleLogout()
    {
        await JS.InvokeVoidAsync("bentoAuth.logout");
        // 跳轉至登錄頁面
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
