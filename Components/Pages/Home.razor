@page "/home"
@attribute [Authorize]
@using bento_order.Services

@inject BentoDbService BentoDbService
@inject GlobalState GlobalState
@inject ISnackbar Snackbar

@* 使用者自己的訂餐月曆 *@
<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4 pb-8">
    <MonthCalendar Month="_month" MonthChanged="OnMonthChanged">
        <CellTemplate Context="date">
            <CalendarCell Date="date"
                TargetUserId="@GlobalState.CurrentUser!.Id"
                Order="@_orders.FirstOrDefault(o => o.OrderDate == date)"
                LockedDate="@_lockedDates.FirstOrDefault(d => d.Date == date)"
                MealTypes="_mealTypes" />
        </CellTemplate>
    </MonthCalendar>

    <MudScrollToTop>
        <MudFab Color="Color.Secondary"
            StartIcon="@Icons.Material.Filled.ArrowUpward" />
    </MudScrollToTop>
</MudContainer>

@code {
    private DateTime _month = AppTime.Today;
    private List<Order> _orders = [];
    private List<LockedDate> _lockedDates = [];
    private List<string> _mealTypes = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mealTypes = (await BentoDbService.GetMealTypesAsync())
                .Select(m => m.Name).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"讀取餐點種類失敗：{ex.Message}", Severity.Error);
        }

        await LoadMonthDataAsync();
    }

    private async Task OnMonthChanged(DateTime month)
    {
        _month = month;
        await LoadMonthDataAsync();
    }

    // 取得整月份資料
    private async Task LoadMonthDataAsync()
    {
        try
        {
            _orders = await BentoDbService.GetOrdersByMonthUserAsync(
                _month.Year, _month.Month, GlobalState.CurrentUser!.Id);
            _lockedDates = await BentoDbService.GetLockedDatesAsync(
                _month.Year, _month.Month);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"讀取訂單失敗：{ex.Message}", Severity.Error);
        }
    }
}
