@using bento_order.Services

@inject BentoDbService BentoDbService
@inject GlobalState GlobalState
@inject IJSRuntime JS
@inject NavigationManager Navigation

<MudTextField @bind-Value="_currentPassword" Label="目前密碼"
    InputType="InputType.Password" Variant="Variant.Outlined"
    Margin="Margin.Dense" Class="mt-2" />
<MudTextField @bind-Value="_newPassword" Label="新密碼"
    InputType="InputType.Password" Variant="Variant.Outlined"
    Margin="Margin.Dense" Class="mt-4"
    HelperText="@($"至少 {BentoDbService.MinPasswordLength} 個字元")" />
<MudTextField @bind-Value="_confirmPassword" Label="確認新密碼"
    InputType="InputType.Password" Variant="Variant.Outlined"
    Margin="Margin.Dense" Class="mt-4" />

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
}

<MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth
    Class="mt-6" OnClick="SubmitAsync" Disabled="@_isSaving">
    確認修改
</MudButton>

@code {
    // 修改成功後通知父元件
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _errorMessage = string.Empty;
    private bool _isSaving;

    private async Task SubmitAsync()
    {
        _errorMessage = string.Empty;

        if (_newPassword != _confirmPassword)
        {
            _errorMessage = "兩次輸入的新密碼不一致";
            return;
        }

        _isSaving = true;
        try
        {
            var error = await BentoDbService.ChangePasswordAsync(
                GlobalState.CurrentUser!.Id,
                _currentPassword,
                _newPassword);

            if (error != null)
            {
                _errorMessage = error;
                return;
            }

            GlobalState.SetMustChangePassword(false);
            await OnChanged.InvokeAsync();

            // 改密碼會讓所有裝置的登入失效（含這台），用新密碼重新登入後重新載入頁面
            await JS.InvokeAsync<string>("bentoAuth.login",
                GlobalState.CurrentUser.Username, _newPassword);
            Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"修改失敗：{ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
