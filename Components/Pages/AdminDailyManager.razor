@page "/admin/daily-manager"
@attribute [Authorize(Roles = Roles.Admin)]
@using bento_order.Services

@inject BentoDbService BentoDbService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2">
    <MudPaper Class="pa-4 mb-2" Style="background-color: var(--bento-panel-bg);">
        <MudDatePicker Label="選擇日期" Date="_selectedDate"
            PickerVariant="PickerVariant.Dialog"
            DateChanged="OnDateChanged"
            Color="Color.Primary" />
    </MudPaper>

    <MudTable Items="_userOrders" Hover Dense FixedHeader Height="600px"
        Style="background-color: var(--bento-panel-bg);">
        <HeaderContent>
            <MudTh>姓名</MudTh>
            <MudTh>狀態</MudTh>
            <MudTh>餐點 1</MudTh>
            <MudTh>餐點 2</MudTh>
            <MudTh>操作</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="姓名">@context.Username</MudTd>
            <MudTd DataLabel="狀態">
                @if (context.HasOrdered)
                {
                    <MudChip T="string" Color="Color.Success"
                        Size="Size.Small">
                        已訂
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Error"
                        Size="Size.Small">
                        未訂
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="餐點">
                @context.OrderData.BentoItem?.Name
            </MudTd>
            <MudTd DataLabel="餐點">
                @context.OrderData.AdditionalBentoItem?.Name
            </MudTd>
            <MudTd DataLabel="操作">
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                    Color="Color.Primary"
                    OnClick="@(() => EditUserOrder(context))" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private DateTime? _selectedDate = AppTime.Today;
    private List<UserOrderDisplay> _userOrders = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }
    
    private async Task OnDateChanged(DateTime? newDate)
    {
        _selectedDate = newDate;
        await LoadData();
    }

    private async Task LoadData()
    {
        if (!_selectedDate.HasValue)
        {
            return;
        }

        try
        {
            _userOrders = await BentoDbService.GetDailyDetailAsync(
                _selectedDate.Value
            );
        }
        catch (Exception ex)
        {
            Snackbar.Add($"讀取訂單失敗：{ex.Message}", Severity.Error);
        }
    }

    // 修改某位使用者在選定日期的訂單
    private async Task EditUserOrder(UserOrderDisplay item)
    {
        if (!_selectedDate.HasValue)
        {
            return;
        }

        var parameters =
            new DialogParameters<CalendarDialog>
        {
            { x => x.Title, $"修改餐點：{item.Username}" },
            { x => x.UserId, item.UserId },
            { x => x.Date, _selectedDate.Value.Date },
            { x => x.Order, item.HasOrdered ? item.OrderData : null }
        };

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small
        };

        var dialog =
            await DialogService.ShowAsync<CalendarDialog>(
            "", parameters, options
        );

        // 不論按確定或關閉，訂單都已自動儲存，重新讀取
        await dialog.Result;
        await LoadData();
    }
}
