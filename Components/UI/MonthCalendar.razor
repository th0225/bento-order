@using System.Globalization
@using bento_order.Services
@inject IJSRuntime JS

@* 月曆版面（標題、切換月份、星期列、日期格），格子內容由 CellTemplate 決定 *@

@* 電腦版：標題卡片在左側（固定不隨捲動），月曆在右側；手機版：標題卡片在上方 *@
<div class="month-calendar">
<aside class="month-side">
<MudPaper Elevation="0" Class="pa-6 rounded-xl shadow-cream month-header">
    <div class="month-header-inner">
        <div class="month-display">
            <MudText Typo="Typo.h4" Style="font-weight: 800">
                @Month.ToString("yyyy")
            </MudText>
            <MudText Typo="Typo.h5" Style="margin-top: -8px;">
                @Month.ToString("MMMM", ZhTw)
            </MudText>
        </div>

        <div class="header-spacer"></div>

        @* 頁面自訂的操作按鈕（例如批次訂餐） *@
        @if (HeaderActions != null)
        {
            <div class="header-actions">@HeaderActions</div>
        }

        <div class="nav-controls">
            <MudIconButton Color="Color.Inherit"
                Icon="@Icons.Material.Filled.ArrowBackIosNew"
                OnClick="@(() => ChangeMonthAsync(Month.AddMonths(-1)))" />
            <MudButton Variant="Variant.Text" Style="font-weight: bold;"
                OnClick="GoToTodayAsync">
                今天
            </MudButton>
            <MudIconButton Color="Color.Inherit"
                Icon="@Icons.Material.Filled.ArrowForwardIos"
                OnClick="@(() => ChangeMonthAsync(Month.AddMonths(1)))" />
        </div>
    </div>
</MudPaper>
</aside>

<div class="month-main">
<div class="calendar-grid mb-2">
    @foreach (var day in WeekDays)
    {
        <div class="weekday-header">@day</div>
    }
</div>

<div class="calendar-grid">
    @for (int i = 0; i < EmptyDaysBefore; i++)
    {
        <div class="empty-cell"></div>
    }

    @for (int d = 1; d <= DaysInMonth; d++)
    {
        var date = new DateTime(Month.Year, Month.Month, d);
        <div @key="date" id="@DayElementId(date)" class="calendar-day">
            @CellTemplate(date)
        </div>
    }
</div>
</div>
</div>

@code {
    private static readonly CultureInfo ZhTw =
        CultureInfo.CreateSpecificCulture("zh-TW");
    private static readonly string[] WeekDays =
        ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"];

    // 顯示的月份（只看年、月）
    [Parameter]
    [EditorRequired]
    public DateTime Month { get; set; }

    // 切換月份時通知父元件（傳入該月 1 日）
    [Parameter]
    public EventCallback<DateTime> MonthChanged { get; set; }

    // 標題卡片內的額外操作按鈕（可選）
    [Parameter]
    public RenderFragment? HeaderActions { get; set; }

    // 每一天的格子內容
    [Parameter]
    [EditorRequired]
    public RenderFragment<DateTime> CellTemplate { get; set; } = default!;

    private int DaysInMonth => DateTime.DaysInMonth(Month.Year, Month.Month);
    private int EmptyDaysBefore =>
        (int)new DateTime(Month.Year, Month.Month, 1).DayOfWeek;

    // 手機版（條列式）開啟時自動捲到今天
    [Parameter]
    public bool ScrollToTodayOnMobile { get; set; }

    // 下次渲染完成後要捲到今天（null = 不捲；值 = 是否平滑捲動）
    private bool? _pendingScrollSmooth;

    private static string DayElementId(DateTime date) =>
        $"calendar-day-{date:yyyy-MM-dd}";

    private bool IsCurrentMonth =>
        Month.Year == AppTime.Today.Year && Month.Month == AppTime.Today.Month;

    private Task ChangeMonthAsync(DateTime month) =>
        MonthChanged.InvokeAsync(new DateTime(month.Year, month.Month, 1));

    private async Task GoToTodayAsync()
    {
        if (ScrollToTodayOnMobile)
        {
            _pendingScrollSmooth = true;
        }

        await ChangeMonthAsync(AppTime.Today);
        // 已經在本月時參數不會變，自己觸發一次渲染以執行捲動
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && ScrollToTodayOnMobile && IsCurrentMonth)
        {
            _pendingScrollSmooth = false;
        }

        if (_pendingScrollSmooth is not { } smooth || !IsCurrentMonth)
        {
            return;
        }

        _pendingScrollSmooth = null;
        try
        {
            await JS.InvokeVoidAsync("bentoCalendar.scrollToDayOnMobile",
                DayElementId(AppTime.Today), smooth);
        }
        catch (JSException)
        {
            // 捲動失敗不影響使用
        }
    }
}
