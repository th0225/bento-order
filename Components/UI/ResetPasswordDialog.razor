@using bento_order.Services

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: bold;">
            重設密碼：@UserName
        </MudText>
    </TitleContent>

    <DialogContent>
        <MudTextField @bind-Value="_password" Label="新密碼"
            Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4"
            HelperText="@($"至少 {BentoDbService.MinPasswordLength} 個字元")" />
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">取消</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
            OnClick="Submit"
            Disabled="@(_password.Length < BentoDbService.MinPasswordLength)">
            確定
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string UserName { get; set; } = string.Empty;

    private string _password = string.Empty;

    // 回傳輸入的新密碼
    private void Submit() => MudDialog.Close(DialogResult.Ok(_password));

    private void Cancel() => MudDialog.Cancel();
}
