@using bento_order.Services

@inject BentoDbService BentoDbService
@inject ISnackbar Snackbar
@inject GlobalState GlobalState

<div class="cell-wrapper @(_isFinalLocked ? "cell-locked" : "")">
    <div class="cell-header">
        <span class="day-num">@Date.Day</span>
        <div class="lock-overlay">
            <MudToggleIconButton
                Toggled="_isFinalLocked"
                ToggledChanged="@((bool val) => OnManualToggleChanged(val))"
                Icon="@Icons.Material.Filled.LockOpen"
                Color="@Color.Success"
                ToggledIcon="@Icons.Material.Filled.LockClock"
                ToggledColor="@Color.Error"
                Class="@(GlobalState.IsAdmin ? "" : "readonly-icon")" />
        </div>
        @if (IsToday)
        {
            <div class="today-tag">TODAY</div>
        }
    </div>

    @* 國定假日名稱、補班等備註 *@
    @if (!string.IsNullOrEmpty(_lockRecord?.Note))
    {
        <div class="day-note @(_lockRecord.IsLocked ? "" : "day-note-open")">
            @_lockRecord.Note
        </div>
    }

    @if (ShowMeals)
    {
        <div class="@(_isFinalLocked ? "rest-mode" : "cell-body")">
            <div class="meal-section">
                <div class="section-label">餐點1</div>
                <div class="select-group">
                    <MudSelect T="string" Placeholder="餐點" Dense Clearable
                        Variant="Variant.Text" Margin="Margin.Dense"
                        Class="flex-grow-2" Disabled="@_isFinalLocked"
                        Value="@_bentoName"
                        ValueChanged="@((string val) =>
                            OnMealChanged(val, isAdditional: false))">
                        @foreach (var type in OptionsFor(_bentoName))
                        {
                            <MudSelectItem Value="@type" />
                        }
                    </MudSelect>
                </div>
            </div>

            <div class="meal-section">
                <div class="section-label">餐點2</div>
                <div class="select-group">
                    <MudSelect T="string" Placeholder="餐點" Dense Clearable
                        Variant="Variant.Text" Margin="Margin.Dense"
                        Class="flex-grow-2" Disabled="@_isFinalLocked"
                        Value="@_addBentoName"
                        ValueChanged="@((string val) =>
                            OnMealChanged(val, isAdditional: true))">
                        @foreach (var type in OptionsFor(_addBentoName))
                        {
                            <MudSelectItem Value="@type" />
                        }
                    </MudSelect>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    [EditorRequired]
    public DateTime Date { get; set; }

    // 訂單要寫給哪位使用者（一般使用者只能是自己，見 OnMealChanged）
    [Parameter]
    public int TargetUserId { get; set; }

    // 該日期已有的訂單，沒有則為 null
    [Parameter]
    public Order? Order { get; set; }

    // 編輯模式（管理員修改他人訂單）：不受鎖定限制
    [Parameter]
    public bool IsEditMode { get; set; } = false;

    // 是否顯示餐點選單（日期鎖定頁只需要鎖定開關）
    [Parameter]
    public bool ShowMeals { get; set; } = true;

    // 該日期在 LockedDates 的紀錄，沒有則為 null
    [Parameter]
    public LockedDate? LockedDate { get; set; }

    // 可選的餐點種類名稱（由頁面從資料庫讀取一次後傳入）
    [Parameter]
    public IReadOnlyList<string> MealTypes { get; set; } = [];

    // 下拉選項：餐點種類，加上目前已選但已被刪除的餐點（讓舊訂單仍能顯示）
    private IEnumerable<string> OptionsFor(string current) =>
        string.IsNullOrEmpty(current) || MealTypes.Contains(current)
            ? MealTypes
            : MealTypes.Append(current);

    private CancellationTokenSource? _cts;
    private bool IsToday => Date.Date == AppTime.Today;
    // 最終上鎖
    private bool _isFinalLocked = false;
    // 畫面上目前選的餐點
    private string _bentoName = string.Empty;
    private string _addBentoName = string.Empty;
    // 最後一次成功儲存的餐點，儲存失敗時還原
    private string _savedBentoName = string.Empty;
    private string _savedAddBentoName = string.Empty;
    // 該日期的鎖定紀錄（管理員切換後就地更新）
    private LockedDate? _lockRecord;

    protected override void OnParametersSet()
    {
        _bentoName = _savedBentoName = Order?.BentoItem?.Name ?? string.Empty;
        _addBentoName = _savedAddBentoName =
            Order?.AdditionalBentoItem?.Name ?? string.Empty;

        _lockRecord = LockedDate;
        _isFinalLocked = !IsEditMode && IsLockedNow();
    }

    // 鎖定規則統一由 OrderLockPolicy 判斷（與伺服器端相同）
    private bool IsLockedNow() =>
        OrderLockPolicy.IsLocked(Date, AppTime.Now, _lockRecord);

    private async Task OnMealChanged(string? value, bool isAdditional)
    {
        if (isAdditional)
        {
            _addBentoName = value ?? string.Empty;
        }
        else
        {
            _bentoName = value ?? string.Empty;
        }

        // 頁面開著時可能已超過截止時間，選餐當下再檢查一次
        if (!GlobalState.IsAdmin && IsLockedNow())
        {
            _isFinalLocked = true;
            RevertToSaved();
            Snackbar.Add("已超過訂餐截止時間，無法修改", Severity.Warning);
            return;
        }

        await TriggerAutoSave();
    }

    private async Task TriggerAutoSave()
    {
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new();

        var order = new Order
        {
            // 一般使用者只能修改自己的訂單
            UserId = GlobalState.IsAdmin ?
                TargetUserId : GlobalState.CurrentUser!.Id,
            OrderDate = Date.Date,
            BentoItem = new() { Name = _bentoName },
            AdditionalBentoItem = new() { Name = _addBentoName }
        };

        try
        {
            await Task.Delay(500, _cts.Token);
            await BentoDbService.UpsertOrderAsync(order, GlobalState.IsAdmin);

            _savedBentoName = order.BentoItem.Name;
            _savedAddBentoName = order.AdditionalBentoItem.Name;
            Snackbar.Add("資料已同步", Severity.Info);
        }
        catch (TaskCanceledException)
        {
            // 被下一次變更取代，由下一次負責儲存
            return;
        }
        catch (UnauthorizedAccessException ex)
        {
            // 伺服器判定已截止或鎖定
            _isFinalLocked = true;
            RevertToSaved();
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (Exception ex)
        {
            RevertToSaved();
            Snackbar.Add($"儲存失敗：{ex.Message}", Severity.Error);
        }

        await InvokeAsync(StateHasChanged);
    }

    // 還原成最後一次成功儲存的餐點
    private void RevertToSaved()
    {
        _bentoName = _savedBentoName;
        _addBentoName = _savedAddBentoName;
    }

    private async Task OnManualToggleChanged(bool value)
    {
        if (!GlobalState.IsAdmin)
        {
            return;
        }

        LockedDate lockedDate = new()
        {
            Date = Date.Date,
            IsLocked = value
        };

        try
        {
            await BentoDbService.SaveLockedDateAsync(lockedDate);
            // 保留原本的備註（例如國定假日名稱）
            lockedDate.Note = _lockRecord?.Note ?? string.Empty;
            _lockRecord = lockedDate;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"儲存失敗：{ex.Message}", Severity.Error);
        }

        // 過去日期與當天截止後，即使解鎖也維持鎖定
        _isFinalLocked = IsLockedNow();
    }
}
