@using bento_order.Services
@inject IJSRuntime JS
@inject MenuService MenuService

@* 每月菜單：可切換月份；圖片可縮放（滾輪、雙指、雙擊、按鈕）與拖曳移動，
   縮放邏輯在 App.razor 的 bentoZoom *@
<MudDialog Style="background-color: #FFFDF7; border-radius: 20px;">
    <DialogContent>
        <div class="month-nav">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                OnClick="@(() => ChangeMonth(-1))" />
            <MudText Typo="Typo.h6" Style="font-weight: 800;">
                @_month.ToString("yyyy 年 M 月")菜單
            </MudText>
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                OnClick="@(() => ChangeMonth(1))" />
        </div>

        @if (!_hasMenu)
        {
            <div class="d-flex justify-center my-8">
                <MudAlert Severity="Severity.Info">
                    @_month.ToString("M 月")的菜單尚未上傳
                </MudAlert>
            </div>
        }
        else
        {
            <div class="zoom-toolbar">
                <MudTooltip Text="縮小">
                    <MudIconButton Icon="@Icons.Material.Filled.ZoomOut"
                        OnClick="@(() => ZoomAsync(1 / ZoomStep))" />
                </MudTooltip>
                <MudTooltip Text="完整顯示">
                    <MudIconButton Icon="@Icons.Material.Filled.FitScreen"
                        OnClick="ResetAsync" />
                </MudTooltip>
                <MudTooltip Text="放大">
                    <MudIconButton Icon="@Icons.Material.Filled.ZoomIn"
                        OnClick="@(() => ZoomAsync(ZoomStep))" />
                </MudTooltip>
            </div>

            <div class="zoom-container" @ref="_container">
                <img src="@MenuService.ImageUrl(_month)"
                    alt="@($"{_month:yyyy 年 M 月}菜單")" draggable="false" />
            </div>

            <MudText Typo="Typo.caption" Align="Align.Center"
                Class="d-block mt-1 zoom-hint">
                滾輪或雙指縮放、雙擊放大，拖曳可移動
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Close"
            Variant="Variant.Text"
            Style="font-weight: 800; width: 100%; height: 50px;">
            關閉菜單
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const double ZoomStep = 1.5;

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    // 一開始顯示的月份（只看年、月）
    [Parameter]
    public DateTime Month { get; set; }

    private DateTime _month;
    private bool _hasMenu;
    private ElementReference _container;
    // 換月份後要把縮放重設成完整顯示
    private bool _resetZoom;

    protected override void OnInitialized()
    {
        _month = new DateTime(Month.Year, Month.Month, 1);
        _hasMenu = MenuService.Exists(_month);
    }

    private void ChangeMonth(int offset)
    {
        _month = _month.AddMonths(offset);
        _hasMenu = MenuService.Exists(_month);
        _resetZoom = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_hasMenu)
        {
            return;
        }

        try
        {
            // attach 重複呼叫沒有影響（從「尚未上傳」切到有菜單時是新的元素）
            await JS.InvokeVoidAsync("bentoZoom.attach", _container);
            if (_resetZoom)
            {
                _resetZoom = false;
                await JS.InvokeVoidAsync("bentoZoom.reset", _container);
            }
        }
        catch (JSException)
        {
            // 縮放功能失效時仍可看圖，不影響使用
        }
    }

    private async Task ZoomAsync(double factor)
    {
        try
        {
            await JS.InvokeVoidAsync("bentoZoom.zoom", _container, factor);
        }
        catch (JSException) { }
    }

    private async Task ResetAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("bentoZoom.reset", _container);
        }
        catch (JSException) { }
    }

    private void Close() => MudDialog.Close();
}
