@page "/admin/system-config"
@attribute [Authorize(Roles = Roles.Admin)]
@using bento_order.Services

@inject BentoDbService BentoDbService
@inject BentoReportService BentoReportService
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-2">
    <MudPaper Class="pa-4 mb-6" Style="background-color: var(--bento-panel-bg);">
        <MudTextField @bind-Value="@_lineAccessToken"
            Label="LINE Access Token" Variant="Variant.Outlined"
            Margin="Margin.Dense"
            InputType="@(_isShowLineAccessToken ?
                InputType.Text : InputType.Password)"
            Adornment="Adornment.End"
            AdornmentIcon="@(_isShowLineAccessToken ?
                Icons.Material.Filled.Visibility :
                Icons.Material.Filled.VisibilityOff)"
            OnAdornmentClick="() => _isShowLineAccessToken =
                !_isShowLineAccessToken" />

        <MudTextField @bind-Value="@_lineId" Class="mt-4"
            Label="LINE 群組/聊天室 ID(每日訂餐)" Variant="Variant.Outlined"
            Margin="Margin.Dense"
            InputType="@(_isShowLineId ? InputType.Text : InputType.Password)"
            Adornment="Adornment.End"
            AdornmentIcon="@(_isShowLineId ?
                Icons.Material.Filled.Visibility :
                Icons.Material.Filled.VisibilityOff)"
            OnAdornmentClick="() => _isShowLineId = !_isShowLineId" />

        <MudTextField @bind-Value="@_lineOrderId" Class="mt-4"
            Label="LINE 群組/聊天室 ID(每月通知訂餐)" Variant="Variant.Outlined"
            Margin="Margin.Dense"
            InputType="@(_isShowLineOrderId ? InputType.Text : InputType.Password)"
            Adornment="Adornment.End"
            AdornmentIcon="@(_isShowLineOrderId ?
                Icons.Material.Filled.Visibility :
                Icons.Material.Filled.VisibilityOff)"
            OnAdornmentClick="() => _isShowLineOrderId = !_isShowLineOrderId" />

        <MudTextField @bind-Value="@_lineReportTitle" Class="mt-4"
            Label="每日統計訊息標題" Variant="Variant.Outlined"
            Margin="Margin.Dense"
            Placeholder="@BentoReportService.DefaultReportTitle"
            HelperText="@($"留空時使用「{BentoReportService.DefaultReportTitle}」")" />

        <MudGrid Class="mt-4">
            <MudItem xs="12" sm="3">
                <MudButton Color="Color.Primary" Variant="Variant.Filled"
                    OnClick="SaveConfigAsync">
                    儲存設定
                </MudButton>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudButton Variant="Variant.Filled" Color="Color.Info"
                    OnClick="SendTestLineMessage" FullWidth
                    StartIcon="@Icons.Material.Filled.NotificationAdd">
                    手動發送Line統計(每日訂餐)
                </MudButton>
            </MudItem>

            <MudItem xs="12" sm="4">
                <MudButton Variant="Variant.Filled" Color="Color.Success"
                    OnClick="SendTestNotifyOrderLineMessage" FullWidth
                    StartIcon="@Icons.Material.Filled.NotificationAdd">
                    手動發送Line通知(每月通知訂餐)
                </MudButton>
            </MudItem>
        </MudGrid>

    </MudPaper>
</MudContainer>

@code {
    private bool _isShowLineAccessToken = false;
    private bool _isShowLineId = false;
    private bool _isShowLineOrderId = false;
    private string? _lineAccessToken = string.Empty;
    private string? _lineId = string.Empty;
    private string? _lineOrderId = string.Empty;
    private string? _lineReportTitle = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadConfigAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"讀取設定失敗：{ex.Message}", Severity.Error);
        }
    }

    private async Task SaveConfigAsync()
    {
        try
        {
            var values = new Dictionary<string, string?>
            {
                [ConfigKeys.LineId] = _lineId,
                [ConfigKeys.LineOrderId] = _lineOrderId,
                [ConfigKeys.LineAccessToken] = _lineAccessToken,
                [ConfigKeys.LineReportTitle] = _lineReportTitle
            };

            foreach (var (key, value) in values)
            {
                await BentoDbService.SaveConfigAsync(new SystemConfig
                {
                    Key = key,
                    Value = value?.Trim() ?? string.Empty
                });
            }

            await LoadConfigAsync();
            Snackbar.Add("系統設定已成功儲存至資料庫", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"儲存失敗：{ex.Message}", Severity.Error);
        }
    }

    private async Task LoadConfigAsync()
    {
        var configs = await BentoDbService.GetConfigAsync();
        string Get(string key) =>
            configs.FirstOrDefault(c => c.Key == key)?.Value ?? string.Empty;

        _lineAccessToken = Get(ConfigKeys.LineAccessToken);
        _lineId = Get(ConfigKeys.LineId);
        _lineOrderId = Get(ConfigKeys.LineOrderId);
        _lineReportTitle = Get(ConfigKeys.LineReportTitle);
    }

    private async Task SendTestLineMessage()
    {
        try
        {
            await BentoReportService.ProcessAndSendReportAsync();
            Snackbar.Add(
                "LINE 統計訊息已成功發送", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"發送失敗：{ex.Message}", Severity.Error);
        }
    }

    private async Task SendTestNotifyOrderLineMessage()
    {
        try
        {
            await BentoReportService.SendNotifyOrderMessageAsync();
            Snackbar.Add(
                "LINE 訂餐提醒已成功發送", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"發送失敗：{ex.Message}", Severity.Error);
        }
    }
}
