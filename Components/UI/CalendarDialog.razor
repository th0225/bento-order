@using bento_order.Services
@inject BentoDbService BentoDbService
@inject ISnackbar Snackbar

@* 管理員修改某位使用者某一天的訂單（不受鎖定限制） *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="font-weight: bold;">
            @Title
        </MudText>
    </TitleContent>

    <DialogContent>
        <CalendarCell Date="Date" TargetUserId="UserId" Order="Order"
            IsEditMode="true" MealTypes="_mealTypes" />
    </DialogContent>

    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
            OnClick="Submit">確定</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "標題";

    // 要修改的使用者
    [Parameter]
    public int UserId { get; set; }

    [Parameter]
    public DateTime Date { get; set; }

    // 該日已有的訂單，沒有則為 null
    [Parameter]
    public Order? Order { get; set; }

    private List<string> _mealTypes = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mealTypes = (await BentoDbService.GetMealTypesAsync())
                .Select(m => m.Name).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"讀取餐點種類失敗：{ex.Message}", Severity.Error);
        }
    }

    void Submit() => MudDialog.Close(DialogResult.Ok(true));
}
