<!DOCTYPE html>
<html lang="zh-Hant-TW" class="@(_themePreference == "dark" ? "bento-dark" : null)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["bento-order.styles.css"]" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;800&display=swap" rel="stylesheet" />
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
    <script>
        // 沒有選過主題（沒有 cookie）時跟隨系統設定；在畫面顯示前就套用，避免閃爍
        if (!document.cookie.includes('bento-theme=') &&
            window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('bento-dark');
        }
    </script>
</head>

<body>
    <Routes @rendermode="InteractiveServer" ThemePreference="@_themePreference" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>

    <script>
        // 登入/登出只負責呼叫 API；身分一律由伺服器端的 cookie 決定
        window.bentoAuth = {
            // 回傳 'ok'、'invalid'（帳密錯誤）、'throttled'（同 IP 嘗試太多次）
            // 或 'locked'（帳號連續失敗太多次，暫時鎖定）
            login: async (username, password) => {
                const response = await fetch('/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ username, password })
                });

                if (response.ok) return 'ok';
                if (response.status === 429) return 'throttled';
                if (response.status === 423) return 'locked';
                return 'invalid';
            },

            logout: async () => {
                await fetch('/auth/logout', {
                    method: 'POST',
                    credentials: 'same-origin'
                });
                // 清除舊版本留下的快取
                localStorage.removeItem('user');
            }
        };

        window.compressImage = async (streamReference, maxWidth, maxHeight, quality) => {
            try {
                // 修正點：Blazor 的 streamReference 需要這樣讀取成 ArrayBuffer
                const arrayBuffer = await streamReference.arrayBuffer();
                const blob = new Blob([arrayBuffer]);
                const url = URL.createObjectURL(blob);
                
                const image = new Image();
                image.src = url;
                
                await new Promise((resolve, reject) => {
                    image.onload = resolve;
                    image.onerror = () => reject(new Error("圖片載入失敗，格式可能有誤"));
                });
                
                URL.revokeObjectURL(url);

                let width = image.width;
                let height = image.height;
                
                // 縮放邏輯
                if (width > height) {
                    if (width > maxWidth) { height *= maxWidth / width; width = maxWidth; }
                } else {
                    if (height > maxHeight) { width *= maxHeight / height; height = maxHeight; }
                }

                const canvas = document.createElement('canvas');
                canvas.width = width;
                canvas.height = height;
                const ctx = canvas.getContext('2d');
                ctx.drawImage(image, 0, 0, width, height);

                // 將結果轉回 byte[] 傳給 C#
                return new Promise((resolve) => {
                    canvas.toBlob((resultBlob) => {
                        const reader = new FileReader();
                        reader.onloadend = () => resolve(new Uint8Array(reader.result));
                        reader.readAsArrayBuffer(resultBlob);
                    }, 'image/jpeg', quality);
                });
            } catch (e) {
                console.error("JS 壓縮發生錯誤:", e);
                throw e;
            }
        };

        // 菜單圖片縮放（MenuDialog 使用）：滾輪、雙指捏合、雙擊、按鈕縮放，拖曳移動。
        // 縮放倍率 1 = 整張圖完整顯示在容器內
        window.bentoZoom = {
            attach: (container) => {
                const img = container.querySelector('img');
                if (!img || container._zoom) return;

                const state = { scale: 1, min: 1, max: 5, base: 0 };
                container._zoom = state;

                // 計算「完整顯示」時的圖片寬度
                const fit = () => {
                    if (!img.naturalWidth) return;
                    // 先縮小圖片讓捲軸消失，才量得到完整的可用空間
                    img.style.width = '0px';
                    state.base = Math.min(container.clientWidth,
                        container.clientHeight * img.naturalWidth / img.naturalHeight);
                    img.style.width = (state.base * state.scale) + 'px';
                };

                // 以容器內的 (cx, cy) 為中心縮放，沒給則以中心點
                state.apply = (newScale, cx, cy) => {
                    newScale = Math.min(state.max, Math.max(state.min, newScale));
                    cx ??= container.clientWidth / 2;
                    cy ??= container.clientHeight / 2;
                    const fx = (container.scrollLeft + cx) / state.scale;
                    const fy = (container.scrollTop + cy) / state.scale;
                    state.scale = newScale;
                    img.style.width = (state.base * newScale) + 'px';
                    container.scrollLeft = fx * newScale - cx;
                    container.scrollTop = fy * newScale - cy;
                };

                const point = (clientX, clientY) => {
                    const r = container.getBoundingClientRect();
                    return [clientX - r.left, clientY - r.top];
                };

                // 圖片可能已載入（快取）或還在載入，兩種情況都要計算
                img.addEventListener('load', fit);
                fit();
                new ResizeObserver(fit).observe(container);

                // 滑鼠滾輪縮放
                container.addEventListener('wheel', e => {
                    e.preventDefault();
                    state.apply(state.scale * (e.deltaY < 0 ? 1.2 : 1 / 1.2),
                        ...point(e.clientX, e.clientY));
                }, { passive: false });

                // 雙擊：原始大小 ↔ 放大
                container.addEventListener('dblclick', e => {
                    state.apply(state.scale > 1 ? 1 : 2.5,
                        ...point(e.clientX, e.clientY));
                });

                // 手機雙指捏合縮放（單指仍是原生捲動）
                let pinch = null;
                const distance = t => Math.hypot(
                    t[0].clientX - t[1].clientX, t[0].clientY - t[1].clientY);
                container.addEventListener('touchstart', e => {
                    if (e.touches.length === 2) {
                        pinch = { dist: distance(e.touches), scale: state.scale };
                    }
                }, { passive: true });
                container.addEventListener('touchmove', e => {
                    if (pinch && e.touches.length === 2) {
                        e.preventDefault();
                        const t = e.touches;
                        state.apply(pinch.scale * distance(t) / pinch.dist,
                            ...point((t[0].clientX + t[1].clientX) / 2,
                                (t[0].clientY + t[1].clientY) / 2));
                    }
                }, { passive: false });
                container.addEventListener('touchend', e => {
                    if (e.touches.length < 2) pinch = null;
                });

                // 電腦版按住拖曳移動（只在拖曳期間監聽 window，避免累積監聽器）
                container.addEventListener('mousedown', e => {
                    if (e.button !== 0) return;
                    e.preventDefault();
                    const start = { x: e.clientX, y: e.clientY,
                        left: container.scrollLeft, top: container.scrollTop };
                    container.classList.add('dragging');

                    const move = ev => {
                        container.scrollLeft = start.left - (ev.clientX - start.x);
                        container.scrollTop = start.top - (ev.clientY - start.y);
                    };
                    const up = () => {
                        container.classList.remove('dragging');
                        window.removeEventListener('mousemove', move);
                        window.removeEventListener('mouseup', up);
                    };
                    window.addEventListener('mousemove', move);
                    window.addEventListener('mouseup', up);
                });
            },

            // 按鈕：factor > 1 放大、< 1 縮小
            zoom: (container, factor) =>
                container?._zoom?.apply(container._zoom.scale * factor),

            reset: (container) => container?._zoom?.apply(1)
        };

        // 月曆（MonthCalendar 使用）：手機條列式時捲到指定日期。
        // 960px 與 MonthCalendar.razor.css 切換成條列式的斷點相同
        window.bentoCalendar = {
            scrollToDayOnMobile: (id, smooth) => {
                if (!window.matchMedia('(max-width: 960px)').matches) return;
                document.getElementById(id)?.scrollIntoView({
                    block: 'start',
                    behavior: smooth ? 'smooth' : 'auto'
                });
            }
        };

        // 主題（MainLayout 的切換按鈕使用）：記在 cookie 讓伺服器下次直接輸出對應配色，
        // 並切換 <html> 的 bento-dark class（app.css 的 CSS 變數依此切換）
        window.bentoTheme = {
            set: (isDark) => {
                document.cookie = 'bento-theme=' + (isDark ? 'dark' : 'light') +
                    '; path=/; max-age=31536000; samesite=lax';
                document.documentElement.classList.toggle('bento-dark', isDark);
            }
        };
    </script>
</body>

</html>

@code {
    // 靜態渲染時可取得 HttpContext，用來讀取主題 cookie
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // "dark"、"light"，或 null（沒有選過，跟隨系統）
    private string? _themePreference;

    protected override void OnInitialized()
    {
        var value = HttpContext?.Request.Cookies["bento-theme"];
        _themePreference = value is "dark" or "light" ? value : null;
    }
}
